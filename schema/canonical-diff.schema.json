{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/civictechdc/DeltaTrack/schema/canonical-diff.schema.json",
  "title": "Canonical Diff JSON",
  "description": "Pipeline-neutral diff between two bill versions. See canonical-diff.md for prose spec.",
  "type": "object",
  "required": ["schema_version", "bill", "versions", "summary", "changes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+$",
      "description": "Major.minor. Consumers reject unknown majors."
    },
    "full_text": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "type": "string" },
            "v2": { "type": "string" }
          }
        }
      ],
      "description": "Optional (v1.1+) full bill text per side, for full-document tracked-changes rendering."
    },
    "full_text_layout": {
      "anyOf": [{ "type": "null" }, { "enum": ["numbered_lines", "paragraphs"] }],
      "description": "Optional (v3.1+) how full_text is laid out. numbered_lines: each row is a 5-character right-aligned line number (5 spaces when unnumbered), 2 spaces, then the text; an empty row separates pages. paragraphs: plain text, an empty row is a paragraph break. Null exactly when full_text is."
    },
    "join_points": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "$ref": "#/$defs/JoinPoints" },
            "v2": { "$ref": "#/$defs/JoinPoints" }
          }
        }
      ],
      "description": "Optional (v3.1+) places a printed word break falls inside full_text, and whether reflowing drops the hyphen. Null when full_text carries no printed line breaks (the XML pipeline, and the reflowed PDF rendering)."
    },
    "tree": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "type": "array", "items": { "$ref": "#/$defs/TreeNode" } },
            "v2": { "type": "array", "items": { "$ref": "#/$defs/TreeNode" } }
          }
        }
      ],
      "description": "Optional (v1.3+) per-side leveled structure tree (#108). Each side is an ordered list of root nodes. Requires full_text present (node spans index into it). A leveled TOC is derivable from the tree, and since #462 the renderer builds the navigation from it alone."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "bill": {
      "type": "object",
      "required": ["type", "number", "congress"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "number": { "type": ["integer", "string"] },
        "congress": { "type": ["integer", "string"] }
      }
    },
    "versions": {
      "type": "object",
      "required": ["v1", "v2"],
      "additionalProperties": false,
      "properties": {
        "v1": { "$ref": "#/$defs/VersionInfo" },
        "v2": { "$ref": "#/$defs/VersionInfo" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/Change" }
    }
  },
  "$defs": {
    "JoinPoints": {
      "type": "object",
      "required": ["at", "drop"],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "DELTA-encoded character offsets into full_text for this side: the first entry is absolute, each later entry is the increment from its predecessor. Each resolved offset addresses the break hyphen that ends a printed line."
        },
        "drop": {
          "type": "string",
          "pattern": "^[01]*$",
          "description": "One character per entry in `at`, in the same order. '1' means reflowing removes the hyphen (a syllable break the printer introduced); '0' means it is kept (the word's own hyphen). Either way the two lines join with no space between them."
        }
      }
    },
    "TreeNode": {
      "type": "object",
      "required": ["label", "level", "own_amounts", "full_text_span", "children"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "level": {
          "enum": ["division", "title", "major", "agency", "account", "section", "subsection", "grouping", "preamble", "heading"],
          "description": "Shared GPO vocabulary (docs/bill-structure.md). Leaf level from the tag/kind; interior positional."
        },
        "own_amounts": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Dollar amounts in THIS node's own block only (not its children's)."
        },
        "full_text_span": { "$ref": "#/$defs/Offset" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/TreeNode" } }
      }
    },
    "VersionInfo": {
      "type": "object",
      "required": ["label", "version_number", "source"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "version_number": { "type": ["integer", "null"] },
        "source": { "enum": ["xml", "pdf"] }
      }
    },
    "Change": {
      "type": "object",
      "required": [
        "id",
        "change_type",
        "section_number",
        "path",
        "location",
        "anchor_resolution",
        "text",
        "move"
      ],
      "additionalProperties": false,
      "properties": {
        "full_text_span": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["v1", "v2"],
              "additionalProperties": false,
              "properties": {
                "v1": { "$ref": "#/$defs/Offset" },
                "v2": { "$ref": "#/$defs/Offset" }
              }
            }
          ]
        },
        "id": { "type": "string" },
        "change_type": { "enum": ["added", "removed", "modified", "moved"] },
        "section_number": { "type": ["string", "null"] },
        "path": {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "$ref": "#/$defs/PathArray" },
            "v2": { "$ref": "#/$defs/PathArray" }
          }
        },
        "location": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["v1", "v2"],
              "additionalProperties": false,
              "properties": {
                "v1": { "$ref": "#/$defs/Range" },
                "v2": { "$ref": "#/$defs/Range" }
              }
            }
          ]
        },
        "anchor_resolution": { "enum": ["resolved", "degraded"] },
        "text": {
          "type": "object",
          "required": ["old", "new"],
          "additionalProperties": false,
          "properties": {
            "old": { "type": ["string", "null"] },
            "new": { "type": ["string", "null"] }
          }
        },
        "move": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/MoveRenumbered" },
            { "$ref": "#/$defs/MoveRelocated" }
          ]
        }
      }
    },
    "Offset": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "PathArray": {
      "anyOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "Range": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["start_page", "start_line", "end_page", "end_line"],
          "additionalProperties": false,
          "properties": {
            "start_page": { "type": "integer", "minimum": 1 },
            "start_line": { "type": ["integer", "null"], "minimum": 1 },
            "end_page": { "type": "integer", "minimum": 1 },
            "end_line": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      ]
    },
    "MoveRenumbered": {
      "type": "object",
      "required": ["kind", "old_label", "new_label", "body_unchanged"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "renumbered" },
        "old_label": { "type": "string" },
        "new_label": { "type": "string" },
        "body_unchanged": { "type": "boolean" }
      }
    },
    "MoveRelocated": {
      "type": "object",
      "required": ["kind", "body_unchanged"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "relocated" },
        "body_unchanged": { "type": "boolean" }
      }
    }
  }
}
