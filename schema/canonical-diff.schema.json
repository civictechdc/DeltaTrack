{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgoraDMV/DeltaTrack/schema/canonical-diff.schema.json",
  "title": "Canonical Diff JSON",
  "description": "Pipeline-neutral diff between two bill versions. See canonical-diff.md for prose spec.",
  "type": "object",
  "required": ["schema_version", "bill", "versions", "summary", "changes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+$",
      "description": "Major.minor. Consumers reject unknown majors."
    },
    "full_text": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "type": "string" },
            "v2": { "type": "string" }
          }
        }
      ],
      "description": "Optional (v1.1+) full bill text per side, for full-document tracked-changes rendering."
    },
    "tree": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "type": "array", "items": { "$ref": "#/$defs/TreeNode" } },
            "v2": { "type": "array", "items": { "$ref": "#/$defs/TreeNode" } }
          }
        }
      ],
      "description": "Optional (v1.3+) per-side leveled structure tree (#108). Each side is an ordered list of root nodes. Requires full_text present (node spans index into it). A leveled TOC is derivable from the tree, and since #462 the renderer builds the navigation from it alone."
    },
    "financial": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["classifier", "v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "classifier": { "type": "string" },
            "v1": { "$ref": "#/$defs/Ledger" },
            "v2": { "$ref": "#/$defs/Ledger" }
          }
        }
      ],
      "description": "Optional (v3.1+) per-side ledger (ADR 0023): every dollar amount in each version, typed by clause and located in the structure tree. Unpaired across sides, like tree; a change object still carries no money. Requires full_text and tree present (spans index into full_text). The report's diff.json download strips it."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "bill": {
      "type": "object",
      "required": ["type", "number", "congress"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "number": { "type": ["integer", "string"] },
        "congress": { "type": ["integer", "string"] }
      }
    },
    "versions": {
      "type": "object",
      "required": ["v1", "v2"],
      "additionalProperties": false,
      "properties": {
        "v1": { "$ref": "#/$defs/VersionInfo" },
        "v2": { "$ref": "#/$defs/VersionInfo" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/Change" }
    }
  },
  "$defs": {
    "Ledger": {
      "type": "object",
      "required": ["amounts_in_text", "sections"],
      "additionalProperties": false,
      "properties": {
        "amounts_in_text": {
          "type": "integer",
          "minimum": 0,
          "description": "Every dollar amount in this side's full_text; the sections' amounts account for all of them when nothing was dropped."
        },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/LedgerSection" } }
      }
    },
    "LedgerSection": {
      "type": "object",
      "required": ["path", "span", "clauses", "pieces", "flags"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "array",
          "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "minItems": 2, "maxItems": 2 },
          "description": "[label, level] pairs from the tree root to the node holding this prose."
        },
        "span": { "$ref": "#/$defs/LedgerSpan" },
        "clauses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/LedgerClause" } },
        "pieces": {
          "type": "array",
          "items": { "type": "array", "minItems": 3, "maxItems": 3 },
          "description": "[start, end, kind] highlight pieces over full_text: the prose split at each `Provided, That` (kind `proviso`), every other piece typed."
        },
        "flags": { "type": "array", "items": { "enum": ["may_hold_several_sections"] } }
      }
    },
    "LedgerClause": {
      "type": "object",
      "required": ["level", "type", "amount", "in_amended_law", "needs_review", "span", "amounts"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["primary", "sub"] },
        "type": {
          "enum": ["appropriation", "transfer", "rescission", "authorization", "fee", "restriction", "directive", "cap", "earmark", "availability", "sub_allocation", "unknown"]
        },
        "amount": {
          "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }],
          "description": "The clause's first dollar figure outside a `not to exceed` ceiling, else its first."
        },
        "in_amended_law": { "type": "boolean", "description": "That amount sits inside text this bill writes into another law." },
        "needs_review": { "type": "boolean", "description": "More than one non-ceiling dollar figure, so `amount` is ambiguous." },
        "span": { "$ref": "#/$defs/LedgerSpan" },
        "amounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "cap", "in_amended_law"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "number", "minimum": 0 },
              "cap": { "type": "boolean" },
              "in_amended_law": { "type": "boolean" }
            }
          }
        }
      }
    },
    "LedgerSpan": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2,
      "description": "[start, end) character offsets into full_text for the same side."
    },
    "TreeNode": {
      "type": "object",
      "required": ["label", "level", "own_amounts", "full_text_span", "children"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "level": {
          "enum": ["division", "title", "major", "agency", "account", "section", "subsection", "grouping", "preamble", "heading"],
          "description": "Shared GPO vocabulary (docs/bill-structure.md). Leaf level from the tag/kind; interior positional."
        },
        "own_amounts": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Dollar amounts in THIS node's own block only (not its children's)."
        },
        "full_text_span": { "$ref": "#/$defs/Offset" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/TreeNode" } }
      }
    },
    "VersionInfo": {
      "type": "object",
      "required": ["label", "version_number", "source"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "version_number": { "type": ["integer", "null"] },
        "source": { "enum": ["xml", "pdf"] }
      }
    },
    "Change": {
      "type": "object",
      "required": [
        "id",
        "change_type",
        "section_number",
        "path",
        "location",
        "anchor_resolution",
        "text",
        "move"
      ],
      "additionalProperties": false,
      "properties": {
        "full_text_span": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["v1", "v2"],
              "additionalProperties": false,
              "properties": {
                "v1": { "$ref": "#/$defs/Offset" },
                "v2": { "$ref": "#/$defs/Offset" }
              }
            }
          ]
        },
        "id": { "type": "string" },
        "change_type": { "enum": ["added", "removed", "modified", "moved"] },
        "section_number": { "type": ["string", "null"] },
        "path": {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "$ref": "#/$defs/PathArray" },
            "v2": { "$ref": "#/$defs/PathArray" }
          }
        },
        "location": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["v1", "v2"],
              "additionalProperties": false,
              "properties": {
                "v1": { "$ref": "#/$defs/Range" },
                "v2": { "$ref": "#/$defs/Range" }
              }
            }
          ]
        },
        "anchor_resolution": { "enum": ["resolved", "degraded"] },
        "text": {
          "type": "object",
          "required": ["old", "new"],
          "additionalProperties": false,
          "properties": {
            "old": { "type": ["string", "null"] },
            "new": { "type": ["string", "null"] }
          }
        },
        "move": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/MoveRenumbered" },
            { "$ref": "#/$defs/MoveRelocated" }
          ]
        }
      }
    },
    "Offset": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "PathArray": {
      "anyOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "Range": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["start_page", "start_line", "end_page", "end_line"],
          "additionalProperties": false,
          "properties": {
            "start_page": { "type": "integer", "minimum": 1 },
            "start_line": { "type": ["integer", "null"], "minimum": 1 },
            "end_page": { "type": "integer", "minimum": 1 },
            "end_line": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      ]
    },
    "MoveRenumbered": {
      "type": "object",
      "required": ["kind", "old_label", "new_label", "body_unchanged"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "renumbered" },
        "old_label": { "type": "string" },
        "new_label": { "type": "string" },
        "body_unchanged": { "type": "boolean" }
      }
    },
    "MoveRelocated": {
      "type": "object",
      "required": ["kind", "body_unchanged"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "relocated" },
        "body_unchanged": { "type": "boolean" }
      }
    }
  }
}
