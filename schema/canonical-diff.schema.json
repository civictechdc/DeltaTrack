{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/civictechdc/DeltaTrack/schema/canonical-diff.schema.json",
  "title": "Canonical Diff JSON",
  "description": "Pipeline-neutral diff between two bill versions. See canonical-diff.md for prose spec.",
  "type": "object",
  "required": ["schema_version", "bill", "versions", "summary", "changes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+$",
      "description": "Major.minor. Consumers reject unknown majors."
    },
    "full_text": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "type": "string" },
            "v2": { "type": "string" }
          }
        }
      ],
      "description": "Optional (v1.1+) full bill text per side, for full-document tracked-changes rendering."
    },
    "full_text_layout": {
      "anyOf": [{ "type": "null" }, { "enum": ["numbered_lines", "paragraphs"] }],
      "description": "Optional (v3.0+) how full_text is laid out. numbered_lines: each row is a 5-character right-aligned line number (5 spaces when unnumbered), 2 spaces, then the text; an empty row separates pages. paragraphs: plain text, an empty row is a paragraph break. Null exactly when full_text is."
    },
    "print_breaks": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "$ref": "#/$defs/PrintBreaks" },
            "v2": { "$ref": "#/$defs/PrintBreaks" }
          }
        }
      ],
      "description": "Optional (v3.0+) where the printer broke a line inside a whole-word line of full_text, so a consumer can lay the text out as printed. Null when full_text was not printed (the XML pipeline)."
    },
    "tree": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "type": "array", "items": { "$ref": "#/$defs/TreeNodeV1" } },
            "v2": { "type": "array", "items": { "$ref": "#/$defs/TreeNodeV2" } }
          }
        }
      ],
      "description": "Optional (v1.3+) per-side leveled structure tree (#108). Each side is an ordered list of root nodes. Requires full_text present (node spans index into it). A leveled TOC is derivable from the tree, and since #462 the renderer builds the navigation from it alone."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "bill": {
      "$ref": "#/$defs/Bill",
      "description": "The bill the comparison is about: each field from versions.v2.bill when it states one, else from versions.v1.bill."
    },
    "versions": {
      "type": "object",
      "required": ["v1", "v2"],
      "additionalProperties": false,
      "properties": {
        "v1": { "$ref": "#/$defs/VersionInfo" },
        "v2": { "$ref": "#/$defs/VersionInfo" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/Change" }
    }
  },
  "$defs": {
    "PrintBreaks": {
      "type": "object",
      "required": ["at", "drop", "line", "seam"],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "DELTA-encoded character offsets into full_text for this side: the first entry is absolute, each later entry is the increment from its predecessor. Each resolved offset is where the text of the printed line that continues the word begins."
        },
        "drop": {
          "type": "string",
          "pattern": "^[01]*$",
          "description": "One character per break, same order as `at`. '1': the printer's hyphen was removed from full_text and is restored before the break. '0': the hyphen is the word's own and is already in full_text."
        },
        "line": {
          "type": "array",
          "items": { "type": ["integer", "null"] },
          "description": "The continuing printed line's line number, same order as `at`; null when the line is unnumbered."
        },
        "seam": {
          "type": "string",
          "pattern": "^[01]*$",
          "description": "One character per break, same order as `at`. '1': the continuing line is the first line of the next page."
        }
      }
    },
    "TreeNode": {
      "description": "A structure-tree node of either side. Its fields are TreeNodeShape's; each child is a TreeNode.",
      "allOf": [{ "$ref": "#/$defs/TreeNodeShape" }],
      "properties": { "children": { "items": { "$ref": "#/$defs/TreeNode" } } }
    },
    "TreeNodeV1": {
      "description": "A node of tree.v1: its id, and each descendant's, carries the v1 prefix.",
      "allOf": [{ "$ref": "#/$defs/TreeNodeShape" }],
      "properties": {
        "id": { "pattern": "^v1\\." },
        "children": { "items": { "$ref": "#/$defs/TreeNodeV1" } }
      }
    },
    "TreeNodeV2": {
      "description": "A node of tree.v2: its id, and each descendant's, carries the v2 prefix.",
      "allOf": [{ "$ref": "#/$defs/TreeNodeShape" }],
      "properties": {
        "id": { "pattern": "^v2\\." },
        "children": { "items": { "$ref": "#/$defs/TreeNodeV2" } }
      }
    },
    "TreeNodeShape": {
      "description": "A tree node's fields. `children` is only typed here: each of TreeNode, TreeNodeV1 and TreeNodeV2 names what its children are, so a subtree is validated once rather than once per wrapper.",
      "type": "object",
      "required": ["label", "level", "own_amounts", "full_text_span", "children"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^v[12]\\.(0|[1-9][0-9]*)$",
          "description": "Optional (v3.0+) the node's identifier: its side, then its 0-based preorder position in that side's tree (\"v1.17\"). Unique per side and deterministic for the same inputs and implementation, but NOT persistent across versions, parser revisions or tree changes. Never derived from label text."
        },
        "label": { "type": "string" },
        "level": {
          "enum": ["division", "title", "major", "agency", "account", "section", "subsection", "grouping", "preamble", "heading"],
          "description": "Shared GPO vocabulary (docs/bill-structure.md). Leaf level from the tag/kind; interior positional."
        },
        "own_amounts": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Dollar amounts in THIS node's own block only (not its children's)."
        },
        "full_text_span": { "$ref": "#/$defs/Offset" },
        "heading_span": {
          "$ref": "#/$defs/Offset",
          "description": "Optional (v3.0+) the whole row of full_text[side] that the node's heading is printed on; null when the producer has no such row for this node. Never found by searching for the label."
        },
        "body_span": {
          "$ref": "#/$defs/Offset",
          "description": "Optional (v3.0+) the node's own body in full_text[side], not its children's; null when the node has no text of its own or the producer cannot place it."
        },
        "children": { "type": "array" }
      }
    },
    "VersionInfo": {
      "type": "object",
      "required": ["label", "version_number", "source"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "version_number": { "type": ["integer", "null"] },
        "source": { "enum": ["xml", "pdf"] },
        "bill": {
          "$ref": "#/$defs/Bill",
          "description": "Optional (v3.0+) what this version itself states about the bill. An unstated field is \"\" (null for title)."
        }
      }
    },
    "Bill": {
      "type": "object",
      "required": ["type", "number", "congress"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "number": { "type": ["integer", "string"] },
        "congress": { "type": ["integer", "string"] },
        "title": {
          "type": ["string", "null"],
          "description": "Optional (v3.0+) the bill's long title (\"Making appropriations for...\"), or null when none was found."
        }
      }
    },
    "Change": {
      "type": "object",
      "required": [
        "id",
        "change_type",
        "section_number",
        "path",
        "location",
        "anchor_resolution",
        "text",
        "move"
      ],
      "additionalProperties": false,
      "properties": {
        "full_text_span": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["v1", "v2"],
              "additionalProperties": false,
              "properties": {
                "v1": { "$ref": "#/$defs/Offset" },
                "v2": { "$ref": "#/$defs/Offset" }
              }
            }
          ]
        },
        "id": { "type": "string" },
        "change_type": { "enum": ["added", "removed", "modified", "moved"] },
        "section_number": { "type": ["string", "null"] },
        "path": {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "$ref": "#/$defs/PathArray" },
            "v2": { "$ref": "#/$defs/PathArray" }
          }
        },
        "node": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["v1", "v2"],
              "additionalProperties": false,
              "properties": {
                "v1": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^v1\\.(0|[1-9][0-9]*)$" }] },
                "v2": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^v2\\.(0|[1-9][0-9]*)$" }] }
              }
            }
          ],
          "description": "Optional (v3.0+) the id of the tree node holding this change on each side. Side v1 applies to removed, modified and moved changes, side v2 to added, modified and moved; an inapplicable side is null, and an applicable side that is null is unresolved. Null when the document has no tree."
        },
        "location": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["v1", "v2"],
              "additionalProperties": false,
              "properties": {
                "v1": { "$ref": "#/$defs/Range" },
                "v2": { "$ref": "#/$defs/Range" }
              }
            }
          ]
        },
        "anchor_resolution": { "enum": ["resolved", "degraded"] },
        "text": {
          "type": "object",
          "required": ["old", "new"],
          "additionalProperties": false,
          "properties": {
            "old": { "type": ["string", "null"] },
            "new": { "type": ["string", "null"] }
          }
        },
        "move": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/MoveRenumbered" },
            { "$ref": "#/$defs/MoveRelocated" }
          ]
        }
      }
    },
    "Offset": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "PathArray": {
      "anyOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "Range": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["start_page", "start_line", "end_page", "end_line"],
          "additionalProperties": false,
          "properties": {
            "start_page": { "type": "integer", "minimum": 1 },
            "start_line": { "type": ["integer", "null"], "minimum": 1 },
            "end_page": { "type": "integer", "minimum": 1 },
            "end_line": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      ]
    },
    "MoveRenumbered": {
      "type": "object",
      "required": ["kind", "old_label", "new_label", "body_unchanged"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["renumbered", "relocated_and_renumbered"] },
        "old_label": { "type": "string" },
        "new_label": { "type": "string" },
        "body_unchanged": { "type": "boolean" }
      }
    },
    "MoveRelocated": {
      "type": "object",
      "required": ["kind", "body_unchanged"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "relocated" },
        "body_unchanged": { "type": "boolean" }
      }
    }
  }
}
